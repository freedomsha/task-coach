n\",\n    \"folder_orange_open_icon\",\n    \"folder_red_open_icon\",\n    \"folder_purple_open_icon\",\n    \"folder_yellow_open_icon\",\n    \"folder_blue_light_open_icon\",\n]\n\nchooseableItemImages[\"\"] = _(\"No icon\")\n
